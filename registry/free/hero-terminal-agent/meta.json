{
  "slug": "hero-terminal-agent",
  "name": "Terminal Agent Hero",
  "tier": "free",
  "platform": "web",
  "category": "hero",
  "description": "A dark devtool hero: headline lines blur in, then a monochrome terminal assembles and an agent plans, writes files, passes tests and opens a PR.",
  "tags": [
    "hero",
    "developer tool",
    "terminal",
    "ai agent",
    "cli",
    "dark",
    "landing page",
    "monochrome"
  ],
  "dependencies": [
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 860,
  "usage": "import { HeroTerminalAgent } from \"@/components/design-for-ai/hero-terminal-agent\";\n\n<HeroTerminalAgent\n  headline={[\"Ship the change,\", \"skip the chores.\"]}\n  emphasis=\"skip the chores.\"\n  installCommand=\"npx northwind@latest init\"\n/>",
  "props": [
    {
      "name": "headline",
      "type": "string[]",
      "default": "[\"The agent\", \"that does the\", \"boring parts\", \"of shipping.\"]",
      "description": "Headline, one string per line; each line blurs in on its own beat."
    },
    {
      "name": "emphasis",
      "type": "string",
      "default": "\"boring parts\"",
      "description": "Phrase set at 45% ink."
    },
    {
      "name": "body",
      "type": "string",
      "description": "Supporting paragraph."
    },
    {
      "name": "primary",
      "type": "{ label: string; href: string }",
      "description": "Solid ink CTA with an arrow."
    },
    {
      "name": "installCommand",
      "type": "string",
      "default": "\"npx relay@latest init\"",
      "description": "Command in the copyable chip."
    },
    {
      "name": "facts",
      "type": "string[]",
      "description": "Mono facts under the actions."
    },
    {
      "name": "tabTitle",
      "type": "string",
      "default": "\"checkout-api\"",
      "description": "Terminal tab title."
    },
    {
      "name": "version",
      "type": "string",
      "default": "\"relay 2.4.1\"",
      "description": "Version in the status bar."
    },
    {
      "name": "session",
      "type": "AgentSession",
      "description": "The scripted session: cwd, command, plan, files, tests and PR."
    },
    {
      "name": "loopPause",
      "type": "number",
      "default": "5200",
      "description": "Ms the finished session holds before it replays."
    },
    {
      "name": "accent",
      "type": "string",
      "default": "\"#d4ff3a\"",
      "description": "The one signal colour, used only for the install chip's Copied confirmation."
    },
    {
      "name": "playback",
      "type": "\"play\" | \"pause\"",
      "description": "Holds or resumes the session from outside. The pause button in the tab bar toggles the same state."
    },
    {
      "name": "speed",
      "type": "number",
      "default": "1",
      "description": "Clock multiplier for the scripted session. 1 is real pace; 3 plays the whole run three times faster."
    },
    {
      "name": "onPlaybackChange",
      "type": "(playback: \"play\" | \"pause\") => void",
      "description": "Called when the pause button in the tab bar holds or resumes the session."
    }
  ],
  "added": "2026-10-07",
  "demo": {
    "steps": [
      "hover:@session-pause",
      "wait:1200",
      "click:@session-pause",
      "hover:@terminal:0.7,0.5",
      "wait:200",
      "click:@session-pause",
      "click:@copy-command",
      "wait:900"
    ]
  },
  "controls": [
    {
      "prop": "playback",
      "label": "Session",
      "kind": "action",
      "options": [
        {
          "value": "pause",
          "label": "Pause"
        },
        {
          "value": "play",
          "label": "Resume"
        }
      ],
      "group": "Terminal"
    },
    {
      "prop": "speed",
      "label": "Session speed",
      "kind": "slider",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "unit": "x",
      "default": 3,
      "group": "Terminal",
      "remount": true
    },
    {
      "prop": "tabTitle",
      "label": "Tab title",
      "kind": "text",
      "default": "checkout-api",
      "group": "Terminal"
    },
    {
      "prop": "version",
      "label": "Version",
      "kind": "text",
      "default": "relay 2.4.1",
      "group": "Terminal"
    },
    {
      "prop": "installCommand",
      "label": "Install command",
      "kind": "text",
      "default": "npx relay@latest init",
      "group": "Copy"
    },
    {
      "prop": "emphasis",
      "label": "Dimmed line",
      "kind": "select",
      "options": [
        {
          "value": "The agent",
          "label": "The agent"
        },
        {
          "value": "that does the",
          "label": "that does the"
        },
        {
          "value": "boring parts",
          "label": "boring parts"
        },
        {
          "value": "of shipping.",
          "label": "of shipping."
        }
      ],
      "default": "boring parts",
      "group": "Copy"
    },
    {
      "prop": "$replay",
      "label": "Demo",
      "kind": "action",
      "value": "Replay",
      "group": "Terminal"
    }
  ]
}
