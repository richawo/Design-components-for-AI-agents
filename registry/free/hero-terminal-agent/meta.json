{
  "slug": "hero-terminal-agent",
  "name": "Terminal Agent Hero",
  "tier": "free",
  "platform": "web",
  "category": "hero",
  "description": "A dark devtool hero: headline lines blur in, then a monochrome terminal assembles and an agent plans, writes files, passes tests and opens a PR.",
  "tags": [
    "hero",
    "developer tool",
    "terminal",
    "ai agent",
    "cli",
    "dark",
    "landing page",
    "monochrome"
  ],
  "dependencies": [
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 860,
  "usage": "import { HeroTerminalAgent } from \"@/components/design-for-ai/hero-terminal-agent\";\n\n<HeroTerminalAgent\n  headline={[\"Ship the change,\", \"skip the chores.\"]}\n  emphasis=\"skip the chores.\"\n  installCommand=\"npx northwind@latest init\"\n/>",
  "props": [
    {
      "name": "headline",
      "type": "string[]",
      "default": "[\"The agent\", \"that does the\", \"boring parts\", \"of shipping.\"]",
      "description": "Headline, one string per line; each line blurs in on its own beat."
    },
    {
      "name": "emphasis",
      "type": "string",
      "default": "\"boring parts\"",
      "description": "Phrase set at 45% ink."
    },
    {
      "name": "body",
      "type": "string",
      "description": "Supporting paragraph."
    },
    {
      "name": "primary",
      "type": "{ label: string; href: string }",
      "description": "Solid ink CTA with an arrow."
    },
    {
      "name": "installCommand",
      "type": "string",
      "default": "\"npx relay@latest init\"",
      "description": "Command in the copyable chip."
    },
    {
      "name": "facts",
      "type": "string[]",
      "description": "Mono facts under the actions."
    },
    {
      "name": "tabTitle",
      "type": "string",
      "default": "\"checkout-api\"",
      "description": "Terminal tab title."
    },
    {
      "name": "version",
      "type": "string",
      "default": "\"relay 2.4.1\"",
      "description": "Version in the status bar."
    },
    {
      "name": "session",
      "type": "AgentSession",
      "description": "The scripted session: cwd, command, plan, files, tests and PR."
    },
    {
      "name": "loopPause",
      "type": "number",
      "default": "5200",
      "description": "Ms the finished session holds before it replays."
    },
    {
      "name": "accent",
      "type": "string",
      "default": "\"#d4ff3a\"",
      "description": "The one signal colour, used only for the install chip's Copied confirmation."
    },
    {
      "name": "playback",
      "type": "\"play\" | \"pause\"",
      "description": "Holds or resumes the session from outside. The pause button in the tab bar toggles the same state."
    }
  ],
  "added": "2026-10-07",
  "demo": {
    "steps": [
      "wait:300",
      "click:@copy-command",
      "hover:@terminal:0.55,0.45",
      "wait:200",
      "click:@session-pause",
      "wait:900",
      "click",
      "wait:600"
    ]
  },
  "controls": [
    {
      "prop": "playback",
      "label": "Session",
      "kind": "action",
      "options": [
        "pause",
        "play"
      ],
      "group": "Terminal"
    },
    {
      "prop": "tabTitle",
      "label": "Tab title",
      "kind": "text",
      "default": "checkout-api",
      "group": "Terminal"
    },
    {
      "prop": "version",
      "label": "Version",
      "kind": "text",
      "default": "relay 2.4.1",
      "group": "Terminal"
    },
    {
      "prop": "installCommand",
      "label": "Install command",
      "kind": "text",
      "default": "npx relay@latest init",
      "group": "Copy"
    },
    {
      "prop": "emphasis",
      "label": "Dimmed phrase",
      "kind": "text",
      "default": "boring parts",
      "group": "Copy"
    },
    {
      "prop": "accent",
      "label": "Copied colour",
      "kind": "color",
      "default": "#d4ff3a",
      "options": [
        "#d4ff3a",
        "#ffffff",
        "#7dd3a8",
        "#60a5fa"
      ],
      "group": "Look"
    },
    {
      "prop": "$replay",
      "label": "Demo",
      "kind": "action",
      "value": "Replay",
      "group": "Terminal"
    }
  ]
}
