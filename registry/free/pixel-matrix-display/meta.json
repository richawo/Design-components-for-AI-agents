{
  "slug": "pixel-matrix-display",
  "name": "Pixel Matrix Display",
  "tier": "free",
  "platform": "web",
  "category": "pixel",
  "description": "A glowing dot-matrix display that powers on in a sweep, then dissolves between a marquee, a live clock, a mic-driven equaliser, a heartbeat and an orbit.",
  "tags": [
    "pixel art",
    "dot matrix",
    "led",
    "canvas",
    "animation",
    "marquee",
    "clock",
    "loader",
    "monochrome"
  ],
  "dependencies": [
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 480,
  "usage": "import { PixelMatrixDisplay } from \"@/components/design-for-ai/pixel-matrix-display\";\n\n<PixelMatrixDisplay\n  text=\"NOW SHIPPING V2   \"\n  scenes={[\"marquee\", \"clock\", \"orbit\"]}\n  color=\"#ffb38a\"\n/>",
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "\"DESIGN FOR AI   \"",
      "description": "Marquee text. A–Z, 0–9 and : . - / % + render; trailing spaces add a gap."
    },
    {
      "name": "scenes",
      "type": "(\"marquee\"|\"clock\"|\"equalizer\"|\"pulse\"|\"orbit\")[]",
      "description": "Scenes to cycle, in order."
    },
    {
      "name": "color",
      "type": "string",
      "default": "\"#f5f5f0\"",
      "description": "Lit dot colour, the display’s one accent; also tints the bloom and the live mic dot."
    },
    {
      "name": "cols",
      "type": "number",
      "default": "72",
      "description": "Matrix columns."
    },
    {
      "name": "rows",
      "type": "number",
      "default": "16",
      "description": "Matrix rows. 16+ renders type at 2×."
    },
    {
      "name": "interval",
      "type": "number",
      "default": "4800",
      "description": "Milliseconds per scene."
    },
    {
      "name": "chrome",
      "type": "boolean",
      "default": "true",
      "description": "Show the scene caption and prev/pause/next controls."
    },
    {
      "name": "microphone",
      "type": "boolean",
      "default": "true",
      "description": "Offer a 'Use mic' toggle that drives the equaliser from live microphone levels (opt-in, asks permission, stops on toggle or unmount)."
    },
    {
      "name": "scene",
      "type": "\"marquee\"|\"clock\"|\"equalizer\"|\"pulse\"|\"orbit\"",
      "description": "Hold on this scene. It must be one of `scenes`. Jumps to it when the value changes and pauses auto-advance while set; prev and next still step."
    }
  ],
  "added": "2026-10-07",
  "demo": {
    "steps": [
      "hover:@next",
      "wait:300",
      "click",
      "wait:1300",
      "click",
      "wait:1300",
      "click",
      "wait:1400"
    ],
    "loop": false
  },
  "controls": [
    {
      "prop": "scene",
      "label": "Scene",
      "kind": "action",
      "options": [
        {
          "value": "marquee",
          "label": "Marquee"
        },
        {
          "value": "clock",
          "label": "Clock"
        },
        {
          "value": "equalizer",
          "label": "Equaliser"
        },
        {
          "value": "pulse",
          "label": "Pulse"
        },
        {
          "value": "orbit",
          "label": "Orbit"
        }
      ]
    },
    {
      "prop": "color",
      "label": "Dot colour",
      "kind": "color",
      "default": "#f5f5f0",
      "options": [
        "#f5f5f0",
        "#ffb38a",
        "#7dd3fc",
        "#a3e635",
        "#f0abfc"
      ]
    },
    {
      "prop": "text",
      "label": "Marquee text",
      "kind": "text",
      "default": "DESIGN FOR AI   "
    },
    {
      "prop": "rows",
      "label": "Rows",
      "kind": "slider",
      "min": 8,
      "max": 16,
      "step": 2,
      "default": 16
    },
    {
      "prop": "cols",
      "label": "Columns",
      "kind": "slider",
      "min": 36,
      "max": 96,
      "step": 6,
      "default": 72
    },
    {
      "prop": "chrome",
      "label": "Caption and controls",
      "kind": "toggle",
      "default": true
    }
  ]
}
