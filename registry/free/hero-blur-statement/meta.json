{
  "slug": "hero-blur-statement",
  "name": "Blur Statement Hero",
  "tier": "free",
  "platform": "web",
  "category": "hero",
  "description": "A studio statement hero on grainy true black: a huge, tightly tracked sentence whose client name blurs and rolls while its slot springs to fit.",
  "tags": [
    "hero",
    "typography",
    "statement",
    "studio",
    "agency",
    "rotating text",
    "blur",
    "dark",
    "film grain",
    "light"
  ],
  "dependencies": [
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 820,
  "usage": "import { HeroBlurStatement } from \"@/components/design-for-ai/hero-blur-statement\";\n\n<HeroBlurStatement\n  lead=\"We build brands for\"\n  nouns={[\n    { word: \"Halden\", note: \"Rebrand, 2026\" },\n    { word: \"Osk\", note: \"Packaging system\" },\n  ]}\n  tail=\"and the shelves\\nthey live on.\"\n  primary={{ label: \"Start a project\", href: \"/contact\" }}\n/>",
  "props": [
    {
      "name": "eyebrow",
      "type": "string",
      "default": "\"Ferro & Vale · Product studio, Lisbon\"",
      "description": "Mono line, top left."
    },
    {
      "name": "status",
      "type": "string",
      "default": "\"Booking from February 2027\"",
      "description": "Mono line, top right, after a small dot."
    },
    {
      "name": "lead",
      "type": "string",
      "default": "\"We design products for\"",
      "description": "Words before the rotating name."
    },
    {
      "name": "nouns",
      "type": "{ word: string; note: string }[]",
      "description": "Names that take turns in the sentence, with a short note shown beside the counter. The first one is the static name with reduced motion."
    },
    {
      "name": "tail",
      "type": "string",
      "default": "\"that people\\nopen on purpose.\"",
      "description": "Words after the name, set at 38% white. A \"\\n\" (or \" / \" in a single-line field) breaks the line on wide containers so nothing re-wraps while the slot springs."
    },
    {
      "name": "primary",
      "type": "{ label: string; href: string }",
      "description": "White pill button with an arrow that nudges 2px on hover."
    },
    {
      "name": "secondary",
      "type": "{ label: string; href: string }",
      "description": "Hairline-ringed pill button."
    },
    {
      "name": "interval",
      "type": "number",
      "default": "2600",
      "description": "How long each name holds, in ms."
    },
    {
      "name": "grain",
      "type": "number",
      "default": "0.07",
      "description": "Film grain opacity, 0–1."
    },
    {
      "name": "theme",
      "type": "\"dark\" | \"light\"",
      "default": "\"dark\"",
      "description": "Grainy true black, or warm-white paper (#f4f3ef) with black ink."
    }
  ],
  "added": "2026-10-09",
  "demo": {
    "steps": [
      "wait:1000",
      "hover:@statement:0.22,0.62",
      "wait:1500",
      "move:0.8,0.3",
      "wait:2200"
    ],
    "loop": false
  },
  "controls": [
    {
      "prop": "theme",
      "label": "Theme",
      "kind": "segmented",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "dark"
    },
    {
      "prop": "interval",
      "label": "Hold each name",
      "kind": "slider",
      "min": 800,
      "max": 5000,
      "step": 100,
      "unit": "ms",
      "default": 2100
    },
    {
      "prop": "grain",
      "label": "Film grain (opacity)",
      "kind": "slider",
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "default": 0.07
    },
    {
      "prop": "lead",
      "label": "Lead-in",
      "kind": "text",
      "default": "We design products for",
      "group": "Content"
    },
    {
      "prop": "tail",
      "label": "Tail",
      "kind": "text",
      "default": "that people / open on purpose.",
      "group": "Content"
    },
    {
      "prop": "eyebrow",
      "label": "Eyebrow",
      "kind": "text",
      "default": "Ferro & Vale · Product studio, Lisbon",
      "group": "Content"
    },
    {
      "prop": "$replay",
      "label": "Replay",
      "kind": "action"
    }
  ]
}
