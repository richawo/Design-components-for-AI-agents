{
  "slug": "pricing-plan-toggle",
  "name": "Plan Card with Billing Toggle",
  "tier": "free",
  "platform": "web",
  "category": "pricing",
  "description": "One plan card under a gliding billing switch: blocks rise from blur, slot-reel digits spin up from zero, the total counts and checks draw in. Monochrome.",
  "tags": [
    "pricing",
    "plan card",
    "billing toggle",
    "slot reel",
    "odometer",
    "seats",
    "saas",
    "dark",
    "monochrome"
  ],
  "dependencies": [
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 900,
  "usage": "import { PricingPlanToggle } from \"@/components/design-for-ai/pricing-plan-toggle\";\n\n<PricingPlanToggle\n  name=\"Pro\"\n  monthly={29}\n  annual={23}\n  saveLabel=\"Save 20%\"\n  seats={{ min: 1, max: 100, initial: 3 }}\n  features={[\"Unlimited projects\", \"Priority support\"]}\n  onCheckout={({ billing, seats }) => startCheckout({ billing, seats })}\n/>",
  "props": [
    {
      "name": "monthly",
      "type": "number",
      "default": "24",
      "description": "Price per seat per month on monthly billing."
    },
    {
      "name": "annual",
      "type": "number",
      "default": "19",
      "description": "Price per seat per month on annual billing."
    },
    {
      "name": "name",
      "type": "string",
      "default": "\"Team\"",
      "description": "Plan name."
    },
    {
      "name": "description",
      "type": "string",
      "description": "One line on who the plan is for."
    },
    {
      "name": "currency",
      "type": "string",
      "default": "\"$\"",
      "description": "Symbol before every amount."
    },
    {
      "name": "locale",
      "type": "string",
      "default": "\"en-US\"",
      "description": "Locale for number formatting."
    },
    {
      "name": "unit",
      "type": "string",
      "default": "\"per seat\\nper month\"",
      "description": "Small print beside the price; \\n splits it over two lines."
    },
    {
      "name": "saveLabel",
      "type": "string",
      "default": "\"Save 20%\"",
      "description": "Badge that springs in on annual billing, in the accent."
    },
    {
      "name": "notes",
      "type": "{ monthly: string; annual: string }",
      "description": "Billing note under the price; cross-fades on toggle."
    },
    {
      "name": "features",
      "type": "string[]",
      "description": "Feature list; each check draws in after its row lands."
    },
    {
      "name": "cta",
      "type": "string",
      "default": "\"Start 14-day trial\"",
      "description": "The checkout button label."
    },
    {
      "name": "ctaDone",
      "type": "string",
      "default": "\"Check your inbox\"",
      "description": "The button label after a successful checkout."
    },
    {
      "name": "onCheckout",
      "type": "({ billing, seats, total }) => void | Promise<unknown>",
      "description": "CTA handler. Return a promise for the loading state."
    },
    {
      "name": "seats",
      "type": "boolean | { min?, max?, initial? }",
      "default": "true (1–50, starts at 5)",
      "description": "Seats stepper and tweened total. false hides it."
    },
    {
      "name": "defaultBilling",
      "type": "\"monthly\" | \"annual\"",
      "default": "\"annual\"",
      "description": "Billing period on first render."
    },
    {
      "name": "footnote",
      "type": "string",
      "default": "\"Prices in USD. Tax added at checkout.\"",
      "description": "Mono small print at the bottom."
    },
    {
      "name": "accent",
      "type": "string",
      "default": "\"#7dd3a8\"",
      "description": "The one signal colour, used only on the save badge."
    },
    {
      "name": "theme",
      "type": "\"dark\" | \"light\"",
      "default": "\"dark\"",
      "description": "Near-black card with white ink, or the white inverse."
    }
  ],
  "added": "2026-10-09",
  "demo": {
    "steps": [
      "wait:500",
      "click:@billing-monthly",
      "wait:550",
      "click:@billing-annual",
      "wait:350",
      "click:@seat-add",
      "wait:150",
      "click",
      "wait:350",
      "click:@checkout",
      "wait:1600"
    ]
  },
  "controls": [
    {
      "prop": "name",
      "label": "Plan name",
      "kind": "text",
      "default": "Team",
      "group": "Content"
    },
    {
      "prop": "cta",
      "label": "Button",
      "kind": "text",
      "default": "Start 14-day trial",
      "group": "Content"
    },
    {
      "prop": "saveLabel",
      "label": "Save badge",
      "kind": "text",
      "default": "Save 20%",
      "group": "Content"
    },
    {
      "prop": "monthly",
      "label": "Monthly price",
      "kind": "slider",
      "min": 5,
      "max": 99,
      "step": 1,
      "default": 24,
      "group": "Pricing"
    },
    {
      "prop": "annual",
      "label": "Annual price",
      "kind": "slider",
      "min": 5,
      "max": 99,
      "step": 1,
      "default": 19,
      "group": "Pricing"
    },
    {
      "prop": "defaultBilling",
      "label": "Opens on",
      "kind": "segmented",
      "options": [
        {
          "value": "monthly",
          "label": "Monthly"
        },
        {
          "value": "annual",
          "label": "Annual"
        }
      ],
      "default": "annual",
      "remount": true,
      "group": "Pricing"
    },
    {
      "prop": "seats",
      "label": "Seats stepper",
      "kind": "toggle",
      "default": true,
      "group": "Pricing"
    },
    {
      "prop": "theme",
      "label": "Theme",
      "kind": "segmented",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "dark",
      "group": "Look"
    },
    {
      "prop": "accent",
      "label": "Accent",
      "kind": "color",
      "default": "#7dd3a8",
      "options": [
        "#7dd3a8",
        "#ff7a45",
        "#60a5fa"
      ],
      "group": "Look"
    }
  ]
}
