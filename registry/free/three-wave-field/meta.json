{
  "slug": "three-wave-field",
  "name": "Wave Field",
  "tier": "free",
  "platform": "web",
  "category": "three-d",
  "description": "A Three.js field of grey points rolling toward the viewer in noise swells. It rises from flat on first view; the pointer lifts the sea and a click drops an accent ripple.",
  "tags": [
    "three.js",
    "webgl",
    "3d",
    "waves",
    "particles",
    "background",
    "shader",
    "monochrome"
  ],
  "dependencies": [
    "three",
    "motion"
  ],
  "theme": "dark",
  "previewHeight": 760,
  "usage": "import { ThreeWaveField } from \"@/components/design-for-ai/three-wave-field\";\n\n<div className=\"relative h-[640px] bg-black\">\n  <div className=\"absolute inset-0\">\n    <ThreeWaveField accent=\"#4cc3ff\" amplitude={0.8} />\n  </div>\n</div>",
  "props": [
    {
      "name": "accent",
      "type": "string",
      "default": "\"#ff7a45\"",
      "description": "The one colour in the field: the mound under the pointer and the ring a click or tap drops. Everything else is grey."
    },
    {
      "name": "amplitude",
      "type": "number",
      "default": "1",
      "description": "Wave height multiplier."
    },
    {
      "name": "speed",
      "type": "number",
      "default": "1",
      "description": "Animation speed multiplier."
    },
    {
      "name": "interactive",
      "type": "boolean",
      "default": "true",
      "description": "Pointer lifts the surface; click or tap drops a ripple."
    },
    {
      "name": "className",
      "type": "string",
      "description": "Classes for the host element, which fills its parent."
    }
  ],
  "added": "2026-10-07",
  "demo": {
    "steps": [
      "wait:700",
      "hover:@field:0.28,0.62",
      "hover:@field:0.72,0.5",
      "click",
      "wait:500",
      "hover:@field:0.5,0.7",
      "click",
      "wait:700",
      "hover:@field:0.2,0.55",
      "wait:300"
    ],
    "loop": false
  },
  "controls": [
    {
      "prop": "accent",
      "label": "Accent",
      "kind": "color",
      "default": "#ff7a45",
      "options": [
        "#ff7a45",
        "#4cc3ff",
        "#a3e635",
        "#f472b6"
      ]
    },
    {
      "prop": "amplitude",
      "label": "Wave height",
      "kind": "slider",
      "min": 0.2,
      "max": 2.2,
      "step": 0.1,
      "default": 1
    },
    {
      "prop": "speed",
      "label": "Speed",
      "kind": "slider",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "prop": "interactive",
      "label": "Pointer response",
      "kind": "toggle",
      "default": true
    }
  ]
}
