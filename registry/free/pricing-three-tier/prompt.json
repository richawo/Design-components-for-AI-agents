{
  "component": "PricingThreeTier",
  "intent": "Premium dark three-plan pricing with a softly glowing featured plan, odometer prices and a sliding billing toggle.",
  "platform": "web",
  "stack": { "framework": "React 19", "styling": "Tailwind CSS v4", "animation": "motion/react", "fonts": "font-sans (Geist), font-mono (Geist Mono)" },
  "layout": {
    "container": "max-w-7xl, px 20/32/48px, py 64-96px",
    "header": "eyebrow, two-tone title, then body (left) + billing toggle (right) on desktop",
    "plans": "3 columns at lg (featured -16px vertical margin); stacked on mobile; at md each card is 2 columns (price | features)",
    "footnotes": "2 columns under a hairline"
  },
  "typography": {
    "title": { "font": "sans", "weight": 600, "size": "clamp(2.25rem, 1.3rem + 3.6vw, 4.5rem)", "leading": 1, "tracking": "-0.05em", "firstClause": "white→white/60 vertical gradient", "secondClause": "white/40" },
    "price": { "size": "clamp(3.25rem, 2.6rem + 2vw, 4.25rem)", "weight": 600, "tracking": "-0.055em", "numerals": "tabular, odometer digits" },
    "planName": { "size": "18px", "weight": 500 },
    "eyebrow": { "font": "mono", "size": "11px", "tracking": "0.18em", "color": "white/45" }
  },
  "color": { "background": "#050506", "text": "#ffffff", "accent": "#34d399", "accentText": "#6ee7b7", "glow": "rgba(52,211,153,0.16) radial at top", "cardFill": "white 4.5%→1.5% vertical gradient", "cardRing": "white/8%", "featuredRing": "emerald 28%" },
  "motion": {
    "toggle": "layoutId spring stiffness 420 damping 36",
    "price": "per-digit odometer, spring stiffness 140 damping 20, 70ms stagger",
    "billingNote": "vertical crossfade 350ms ease [0.2,0.8,0.2,1]",
    "cta": "arrow translates 2px on hover",
    "reducedMotion": "instant swaps"
  },
  "responsive": { "mobile": "stacked cards, toggle under body, full-width CTAs", "md": "cards split into price | features", "lg": "three columns, featured lifted" },
  "accessibility": ["section aria-labelledby the title", "radiogroup toggle with arrow keys", "sr-only price sentence", "visible focus rings"],
  "content": { "plans": ["Sole $12/$10", "Practice $36/$30 (featured)", "Firm $84/$70"], "saving": "2 months free", "footnotes": 2 },
  "avoid": ["rotated stickers", "hand-drawn arrows", "serif italic accents", "neon highlighter tags", "bright gradient text", "identical cards"]
}
