{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Its own Worker, like launch-yaps and post-yaps: the main yaps-site Worker
  // and the apex domain are untouched.
  "name": "design-yaps",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "design.yaps.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://design.yaps.ai",
    "EMAIL_FROM": "Design for AI <hello@yaps.ai>",
    "STRIPE_PRICE_PRO_YEARLY": "price_1UOn9DGf6SO9vB2D2Op2WIg7",
    "STRIPE_PRICE_PRO_LIFETIME": "price_1UOn9EGf6SO9vB2DP9SoOfOz",
    "STRIPE_PRICE_TEAM_YEARLY": "price_1UOn9FGf6SO9vB2DshMCKSbG",
    "STRIPE_PRICE_TEAM_LIFETIME": "price_1UOn9GGf6SO9vB2DwKTCOarP",
    "STRIPE_PORTAL_CONFIGURATION": "bpc_1UOnNbGf6SO9vB2DP2VXN7io",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "d1_databases": [{
    "binding": "COMMERCE_DB",
    "database_name": "design-yaps-commerce",
    "database_id": "d1a4a9fc-8234-45c1-a524-f44614c62b3b",
    "migrations_dir": "migrations"
  }],
  // Encrypted runtime secrets: LICENSE_SECRET, AUTH_SECRET, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, RESEND_API_KEY and, optionally, LICENSE_REVOKED.
  // PRO_REPO_SSH_KEY belongs to Workers Builds, not the runtime.
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
