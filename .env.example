# Public URL of the site (used in canonical URLs, sitemap, registry items)
NEXT_PUBLIC_SITE_URL=https://design.yaps.ai

# Signs licence keys. 32+ random characters. Keep it secret and stable.
LICENSE_SECRET=

# Comma-separated licence ids to revoke
LICENSE_REVOKED=

# Stripe (Checkout via REST, no SDK)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_TEAM_LIFETIME=

# CI only: read access to the private Pro repo, used by `npm run pro:sync`
PRO_REPO_TOKEN=
